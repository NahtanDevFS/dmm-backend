generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model auditoria_log {
  id                    BigInt                @id @default(autoincrement())
  tabla_afectada        String                @db.VarChar(50)
  registro_id           Int
  tipo_accion_id        Int
  usuario_id            Int?
  fecha_hora            DateTime              @default(now()) @db.Timestamp(6)
  valores_antiguos      Json?
  valores_nuevos        Json?
  tipo_accion_auditoria tipo_accion_auditoria @relation(fields: [tipo_accion_id], references: [id], onUpdate: NoAction, map: "fk_auditoria_tipo_accion")
  usuario               usuario?              @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_auditoria_usuario")

  @@index([tipo_accion_id], map: "idx_auditoria_tipo_accion")
  @@index([fecha_hora(sort: Desc)], map: "idx_auditoria_fecha")
  @@index([tabla_afectada, registro_id], map: "idx_auditoria_tabla_registro")
  @@index([usuario_id], map: "idx_auditoria_usuario", where: raw("(usuario_id IS NOT NULL)"))
}

