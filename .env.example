
#Este es un archivo de ejemplo para que el equipo vea lo que deben colocar en el .env real
# Cadena de conexión a PostgreSQL. Usada tanto por Prisma (lecturas/CRUD)
# como por el pool de pg directo (transacciones con SET LOCAL y stored procedures).
DATABASE_URL="postgresql://usuario:password@localhost:5432/dmm_usumatlan"

# Dueño del esquema: solo para `prisma db pull` y migraciones. La app nunca lo usa.
DATABASE_URL_OWNER="postgresql://postgres:pass123@localhost:5432/dmm_usumatlan"

# Tests: misma separación, contra dmm_test
DATABASE_URL_TEST="postgresql://usuario:password@localhost:5432/dmm_usumatlan_test"
DATABASE_URL_TEST_OWNER="postgresql://usuario:password@localhost:5432/dmm_usumatlan_test"

# Puerto en el que escucha el servidor Express
PORT=4000

# Entorno de ejecución: development | production
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173

# Carpeta donde se guardan los archivos subidos
UPLOADS_DIR=./uploads