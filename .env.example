
#Este es un archivo de ejemplo para que el equipo vea lo que deben colocar en el .env real
# Cadena de conexión a PostgreSQL. Usada tanto por Prisma (lecturas/CRUD)
# como por el pool de pg directo (transacciones con SET LOCAL y stored procedures).
DATABASE_URL="postgresql://usuario:password@localhost:5432/dmm_usumatlan"

# Puerto en el que escucha el servidor Express
PORT=4000

# Entorno de ejecución: development | production
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173